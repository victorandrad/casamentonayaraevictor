# .env do servidor (/opt/casamento/.env). Fica só no VPS, nunca no git.
# Login do painel, Stripe e remetente dos e-mails NÃO ficam aqui: vêm dos secrets/variables do GitHub e o
# casamento-deploy grava em /opt/casamento/segredos.env a cada deploy.

# Domínio público (sem https://)
DOMINIO=casamentonayaraevictor.com.br

# Banco: senha longa e aleatória (ex.: openssl rand -hex 24)
POSTGRES_DB=casamento
POSTGRES_USER=casamento
POSTGRES_PASSWORD=

# Servidor de e-mail (outro projeto Docker, compartilhado entre domínios; só envia)
# Rede Docker do projeto de e-mail (a API entra nela para enviar os e-mails)
EMAIL_REDE=email
# Nome do servidor (o do certificado; precisa ser alias do container na rede acima)
MAIL_HOSTNAME=mail.casamentonayaraevictor.com.br

# Gravados pelo casamento-deploy a cada deploy (commit publicado de cada imagem)
API_TAG=latest
WEB_TAG=latest
