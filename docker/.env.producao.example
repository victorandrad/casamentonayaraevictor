# .env do servidor (/opt/casamento/.env). Fica só no VPS, nunca no git.

# Domínio público (sem https://)
DOMINIO=casamentonayaraevictor.com.br

# Banco: senha longa e aleatória (ex.: openssl rand -base64 32)
POSTGRES_DB=casamento
POSTGRES_USER=casamento
POSTGRES_PASSWORD=

# Conta do painel, criada/atualizada com:
#   docker compose -f compose.yaml -f compose.producao.yaml exec api node src/seed.ts
ADMIN_EMAIL=
ADMIN_NOME="Nayara & Victor"
ADMIN_PASSWORD=

# Stripe em modo real (sk_live_...). O segredo do webhook vem do endpoint
# https://casamentonayaraevictor.com.br/api/stripe/webhook criado no Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mail dos recibos (SMTP de um provedor: Brevo, Amazon SES, Resend, Zoho…)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nayara & Victor <presentes@casamentonayaraevictor.com.br>"
EMAIL_REPLY_TO=

# Gravados pelo casamento-deploy a cada deploy (commit publicado de cada imagem)
API_TAG=latest
WEB_TAG=latest
