# Copie para o servidor como .env (na pasta do deploy, ex.: /opt/casamento/.env)
# e preencha. Este arquivo NÃO vai para o GitHub com valores reais.

# Domínio (sem https://) e e-mail para o certificado HTTPS (Let's Encrypt)
SITE_DOMAIN=casamentonayaraevictor.com.br
ACME_EMAIL=

# Banco: use uma senha longa e aleatória (ex.: openssl rand -base64 32)
POSTGRES_DB=casamento
POSTGRES_USER=casamento
POSTGRES_PASSWORD=

# Conta do painel, criada/atualizada com:
#   docker compose -f docker-compose.prod.yml --env-file .env --env-file imagens.env exec api node src/seed.ts
ADMIN_EMAIL=
ADMIN_NOME="Nayara & Victor"
ADMIN_PASSWORD=

# Stripe em modo real (sk_live_...). O segredo do webhook vem do endpoint
# https://casamentonayaraevictor.com.br/api/stripe/webhook criado no Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mail dos recibos (SMTP de um provedor: Brevo, Amazon SES, Resend, Zoho…)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nayara & Victor <presentes@casamentonayaraevictor.com.br>"
EMAIL_REPLY_TO=
