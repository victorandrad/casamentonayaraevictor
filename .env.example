# Copie para .env e ajuste. Os valores abaixo servem só para desenvolvimento local.

# Banco (Postgres no Docker)
POSTGRES_DB=casamento
POSTGRES_USER=casamento
POSTGRES_PASSWORD=casamento_dev_local
POSTGRES_PORT=5433

# API
API_PORT=4100
NODE_ENV=development
# Origens que podem chamar a API (o shell). Separe por vírgula.
ALLOWED_ORIGINS=http://localhost:4000
# Em produção (https) use true.
COOKIE_SECURE=false

# Conta de acesso ao painel criada/atualizada pelo comando de seed (npm run db:seed).
# Troque a senha antes de usar de verdade.
ADMIN_EMAIL=noivos@nayaraevictor.local
ADMIN_NOME="Nayara & Victor"
ADMIN_PASSWORD=painel-dev-2027

# O Mercado Pago (pagamento dos presentes) é configurado no painel, em Configurações: nada vai aqui.
# Endereço público do site (para onde o Mercado Pago devolve o convidado e os noivos)
SITE_URL=http://localhost:4000

# E-mail dos recibos. Em desenvolvimento, o servidor Mailpit do Docker recebe tudo
# e mostra em http://localhost:8025. Em produção, aponte para o seu servidor SMTP.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nayara & Victor <nao-responder@nayaraevictor.local>"
EMAIL_REPLY_TO=
